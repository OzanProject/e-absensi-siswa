        <tr><td class="center">7</td><td>status</td><td>ENUM</td><td>DEFAULT pending</td><td>pending, approved, rejected</td></tr>
        <tr><td class="center">8</td><td>approved_by</td><td>BIGINT</td><td><span class="badge-fk">FK</span></td><td>→ users.id (yang menyetujui)</td></tr>
        <tr><td class="center">9</td><td>created_at</td><td>TIMESTAMP</td><td>NULLABLE</td><td>Waktu pembuatan record</td></tr>
