        <tr>
            <th style="width: 5%;">No</th>
            <th style="width: 22%;">Nama Kolom</th>
            <th style="width: 15%;">Tipe Data</th>
            <th style="width: 10%;">Constraint</th>
            <th style="width: 48%;">Keterangan</th>
        </tr>
        <tr><td class="center">1</td><td>id</td><td>BIGINT</td><td><span class="badge-pk">PK</span></td><td>Primary key, auto increment</td></tr>
