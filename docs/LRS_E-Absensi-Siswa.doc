<!-- ==================== BAB 4: PEMETAAN FK ==================== -->
<div class="page-break">
    <h2>4. Pemetaan Foreign Key (FK)</h2>
    <p>Berikut adalah pemetaan seluruh <i>foreign key</i> yang menghubungkan antar tabel dalam LRS:</p>

    <table>
        <tr>
            <th style="width: 5%;">No</th>
            <th style="width: 22%;">Tabel Asal</th>
            <th style="width: 18%;">Kolom FK</th>
            <th style="width: 22%;">Tabel Referensi</th>
            <th style="width: 15%;">Kolom Referensi</th>
            <th style="width: 18%;">Kardinalitas</th>
        </tr>
        <tr><td class="center">1</td><td>students</td><td>class_id</td><td>classes</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">2</td><td>homeroom_teachers</td><td>user_id</td><td>users</td><td>id</td><td class="center">1 : 1</td></tr>
        <tr><td class="center">3</td><td>homeroom_teachers</td><td>class_id</td><td>classes</td><td>id</td><td class="center">1 : 1</td></tr>
        <tr><td class="center">4</td><td>parents</td><td>user_id</td><td>users</td><td>id</td><td class="center">1 : 1</td></tr>
        <tr><td class="center">5</td><td>parent_student</td><td>parent_id</td><td>parents</td><td>id</td><td class="center">M : N</td></tr>
        <tr><td class="center">6</td><td>parent_student</td><td>student_id</td><td>students</td><td>id</td><td class="center">M : N</td></tr>
        <tr><td class="center">7</td><td>absences</td><td>student_id</td><td>students</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">8</td><td>absences</td><td>recorded_by</td><td>users</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">9</td><td>izin_requests</td><td>student_id</td><td>students</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">10</td><td>izin_requests</td><td>approved_by</td><td>users</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">11</td><td>announcements</td><td>target_id</td><td>classes</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">12</td><td>schedules</td><td>class_id</td><td>classes</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">13</td><td>schedules</td><td>subject_id</td><td>subjects</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">14</td><td>schedules</td><td>teacher_id</td><td>users</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">15</td><td>teaching_journals</td><td>schedule_id</td><td>schedules</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">16</td><td>teaching_journals</td><td>teacher_id</td><td>users</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">17</td><td>subject_attendances</td><td>teaching_journal_id</td><td>teaching_journals</td><td>id</td><td class="center">N : 1</td></tr>
        <tr><td class="center">18</td><td>subject_attendances</td><td>student_id</td><td>students</td><td>id</td><td class="center">N : 1</td></tr>
